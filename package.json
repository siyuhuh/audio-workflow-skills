{
  "name": "audio-workflow-skills",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @vocalflow/desktop dev",
    "dev:ui": "pnpm --filter @vocalflow/desktop dev:ui",
    "build": "pnpm --filter @vocalflow/desktop build",
    "dist": "pnpm --filter @vocalflow/desktop dist",
    "dist:mac": "pnpm --filter @vocalflow/desktop dist:mac",
    "dist:win": "pnpm --filter @vocalflow/desktop dist:win",
    "start": "pnpm --filter @vocalflow/desktop start",
    "promo": "pnpm --filter @vocalflow/promo dev",
    "promo:render": "pnpm --filter @vocalflow/promo render"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.9.0",
      "tar": "^7.5.22",
      "axios": "^1.20.0",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "fast-uri": "^3.1.8",
      "form-data": "^4.0.6",
      "http-cache-semantics": "^4.3.0",
      "js-yaml": "^4.3.2",
      "joi": "^18.2.9",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^7.1.6",
      "source-map-js": "^1.2.2",
      "tmp": "^0.2.6",
      "undici": "^6.28.1",
      "esbuild": "^0.28.2",
      "@babel/core": "^7.29.6",
      "@xmldom/xmldom@>=0.8.0 <0.9.0": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.10.0": "0.9.12",
      "brace-expansion@>=1.0.0 <2.0.0": "1.1.21",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
      "brace-expansion@>=3.0.0 <6.0.0": "5.0.12",
      "fflate@>=0.6.0 <0.7.0": "0.6.11",
      "fflate@>=0.8.0 <0.9.0": "0.8.3"
    }
  }
}
